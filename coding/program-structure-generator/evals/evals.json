      "assertions": [
        { "id": "react-ts-1", "check": "tree_format_chars", "expected": true, "description": "Output contains tree formatting characters" },
        { "id": "react-ts-2", "check": "contains_path", "expected": "src/", "description": "Structure includes src/ directory" },
        { "id": "react-ts-3", "check": "contains_path", "expected": "src/components/", "description": "Structure includes components/ under src/" },
        { "id": "react-ts-4", "check": "contains_path", "expected": "src/hooks/", "description": "Structure includes hooks/ under src/" },
        { "id": "react-ts-5", "check": "contains_path", "expected": "src/services/", "description": "Structure includes services/ under src/" },
        { "id": "react-ts-6", "check": "contains_path", "expected": "src/types/", "description": "Structure includes types/ under src/" },
        { "id": "react-ts-7", "check": "contains_path", "expected": "src/utils/", "description": "Structure includes utils/ under src/" },
        { "id": "react-ts-8", "check": "contains_path", "expected": "public/", "description": "Structure includes public/ directory" },
        { "id": "react-ts-9", "check": "contains_path", "expected": "tests/", "description": "Structure includes tests/ directory" },
        { "id": "react-ts-10", "check": "contains_path", "expected": ".gitignore", "description": "Structure includes .gitignore" },
        { "id": "react-ts-11", "check": "contains_path", "expected": "README.md", "description": "Structure includes README.md" },
        { "id": "react-ts-12", "check": "contains_path", "expected": "package.json", "description": "Structure includes package.json" },
        { "id": "react-ts-13", "check": "contains_path", "expected": "tsconfig.json", "description": "Structure includes tsconfig.json" },
        { "id": "react-ts-14", "check": "contains_path", "expected": "Dockerfile", "description": "Structure includes Dockerfile" },
        { "id": "react-ts-15", "check": "contains_path", "expected": "docker-compose.yml", "description": "Structure includes docker-compose.yml" },
        { "id": "react-ts-16", "check": "contains_path", "expected": ".github/workflows/", "description": "Structure includes .github/workflows/" },
        { "id": "react-ts-17", "check": "contains_path", "expected": "LICENSE", "description": "Structure includes LICENSE" },
        { "id": "react-ts-18", "check": "contains_path", "expected": ".env.example", "description": "Structure includes .env.example" },
